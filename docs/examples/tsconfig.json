// Redraw requires the separately supplied vendor tarball documented in 11-redraw.tsx.
{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "jsxImportSource": "@compound/jsx",
    "lib": [
      "ES2024",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "@webgpu/types"
    ]
  },
  "include": [
    "*.tsx"
  ],
  "exclude": [
    "11-redraw.tsx"
  ]
}
