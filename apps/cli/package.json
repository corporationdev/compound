{
  "name": "@compound/cli",
  "private": true,
  "version": "0.205.4",
  "license": "MPL-2.0",
  "bin": {
    "compound": "./dist/index.js"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=cjs --outfile=dist/index.js && chmod +x dist/index.js",
    "check": "tsc --noEmit",
    "symlink:remove": "rm -f /opt/homebrew/bin/compound",
    "symlink:create": "bun run build && ln -sf \"$PWD/dist/index.js\" /opt/homebrew/bin/compound"
  },
  "dependencies": {
    "@compound/dapi": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "commander": "^14.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "esbuild": "^0.28.1",
    "typescript": "~5.9.3"
  }
}
