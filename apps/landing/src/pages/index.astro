---
import { release } from '@compound/config/release';
import logo from '../../../../assets/compound-logo-transparent.png';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Compound. The video editor built for agents. Download for Mac." />
    <meta name="theme-color" content="#f7f7f5" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>Compound</title>
    <style is:inline>
      * { box-sizing: border-box; }
      html { background: #f7f7f5; color: #181818; color-scheme: light; }
      body { margin: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; }
      main { min-height: 100svh; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 32px 24px 72px; }
      .identity { display: flex; align-items: center; justify-content: center; gap: 15px; font-size: clamp(42px, 8vw, 56px); }
      /* Center the artwork against the visible letters, accounting for the font's ascender space. */
      .mark { display: block; flex: 0 0 72px; width: 72px; height: 72px; object-fit: contain; transform: translateY(0.09em); }
      h1 { margin: 0; font-size: inherit; font-weight: 550; letter-spacing: -0.055em; line-height: 1.1; }
      .download { display: inline-flex; align-items: center; justify-content: center; gap: 9px; min-height: 48px; margin-top: 38px; padding: 0 21px; border-radius: 12px; background: #181818; color: #fff; font-size: 14px; font-weight: 500; text-decoration: none; transition: background 150ms ease; }
      .download:hover { background: #383838; }
      .download:focus-visible { outline: 3px solid #787878; outline-offset: 5px; }
      @media (max-width: 380px) { .mark { flex-basis: 60px; width: 60px; height: 60px; } .identity { gap: 9px; } }
      @media (prefers-reduced-motion: reduce) { .download { transition: none; } }
    </style>
  </head>
  <body>
    <main>
      <div class="identity">
        <img class="mark" src={logo.src} width="72" height="72" loading="eager" fetchpriority="high" alt="" />
        <h1>compound</h1>
      </div>
      <a class="download" href={release.downloadUrl}>
        <svg aria-hidden="true" viewBox="0 0 24 24" width="24" height="24" fill="currentColor">
          <path d="M17.1 12.3c0-2 1.6-3 1.7-3.1-1-1.4-2.4-1.6-2.9-1.6-1.2-.1-2.4.7-3 .7-.6 0-1.5-.7-2.5-.7-1.3 0-2.5.8-3.2 1.9-1.4 2.3-.4 5.7.9 7.6.6.9 1.3 1.9 2.3 1.8.9 0 1.3-.6 2.5-.6 1.2 0 1.5.6 2.5.6s1.6-.9 2.2-1.8c.7-1 1-2 1-2.1-.1 0-2-.8-2-2.7ZM15.1 6.3c.5-.7.9-1.6.8-2.5-.8.1-1.8.6-2.4 1.3-.5.6-1 1.5-.9 2.4.9.1 1.9-.5 2.5-1.2Z" />
        </svg>
        Download for Mac
      </a>
    </main>
  </body>
</html>
