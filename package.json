{
  "name": "@compound/editor",
  "version": "0.205.0",
  "private": true,
  "license": "MPL-2.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "dev:client": "bun scripts/dev-client.ts",
    "dev:thinkpad": "bun scripts/dev-client.ts --stage dev-isaacdyor-107806b0",
    "dev:web_v1": "bun run --cwd apps/web dev",
    "dev:landing": "bun run --cwd apps/landing dev",
    "build:landing": "bun run --cwd apps/landing build",
    "dev:desktop": "node scripts/dev-desktop.mjs",
    "build": "bun run --cwd apps/web build",
    "build:web_v1": "bun run --cwd apps/web build",
    "build:desktop": "bun run --cwd apps/desktop build",
    "make": "bun run --cwd apps/desktop make",
    "release": "node scripts/release.mjs",
    "postinstall": "patch-package && node scripts/link-backend-externals.mjs",
    "lint": "bun run --filter \"*\" --if-present lint",
    "check": "bun run --filter \"*\" --if-present check && tsc -p docs/examples --noEmit && tsc -p scripts --noEmit",
    "test": "bun run --filter \"*\" --if-present test",
    "dev:backend": "bun scripts/backend.ts dev",
    "dev:infra": "bun scripts/infra.ts dev",
    "dev:server": "bun scripts/infra.ts dev",
    "deploy:infra": "bun scripts/infra.ts deploy",
    "destroy": "bun scripts/infra.ts destroy",
    "secrets:inject": "bun scripts/secrets-inject.ts",
    "runtime:write": "bun scripts/write-runtime-env.ts",
    "setup": "bun scripts/setup.ts",
    "deploy": "bun scripts/deploy.ts",
    "catalog:publish": "bun scripts/catalog.ts",
    "test:cloud": "bun test apps/server/test packages/backend/test packages/assets/test scripts/environment.test.ts apps/desktop/test/cloud.test.ts apps/web/test/access-token.test.ts apps/web/test/catalog-preview.test.ts apps/web/test/catalog-cache.test.ts apps/web/test/catalog-list.test.ts apps/web/test/catalog-discovery.test.ts",
    "brand:assets": "node scripts/generate-brand-assets.mjs",
    "test:branding": "bun test apps/desktop/test/brand-migration.test.ts apps/web/test/brand-migration.test.ts",
    "test:transcription": "bun test packages/backend/test apps/server/test apps/desktop/test/cloud.test.ts packages/encoder/test && bun test apps/web/test/transcription-client.test.ts"
  },
  "devDependencies": {
    "@typegpu/noise": "0.11.0",
    "@types/bun": "^1.3.0",
    "@types/three": "^0.185.4",
    "dotenv": "^17.2.2",
    "fake-indexeddb": "^6.2.5",
    "patch-package": "^8.0.1",
    "sharp": "^0.34.5",
    "three": "^0.186.0"
  },
  "packageManager": "bun@1.3.11",
  "dependencies": {
    "@compound/config": "workspace:*"
  }
}
