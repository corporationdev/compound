# Deployment
STAGE=dev
CONVEX_DEPLOY_KEY=
# Preview lifecycle only; not synced to the Convex application runtime.
CONVEX_MANAGEMENT_TOKEN=

# Auth secrets
BETTER_AUTH_SECRET=
RESEND_API_KEY=

# Generated by runtime:write from stage and public deployment identity
CONVEX_URL=
CONVEX_SITE_URL=
SITE_URL=
RESEND_FROM_EMAIL=

# Transcription actions (same stage-scoped providers/storage as the Worker)
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
MEDIA_BUCKET_NAME=
DEEPGRAM_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Music search and audio preparation (server-side only)
APIFY_TOKEN=

# Social posting (Zernio); SERVER_URL is generated from the stage
ZERNIO_API_KEY=
ZERNIO_WEBHOOK_SECRET=
SERVER_URL=
