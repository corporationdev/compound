# 1Password-backed credentials. Runtime URLs and model choices live in @compound/config.
# STAGE (dev-…, pr-…, prod) selects an ENV_TIER vault: dev, preview, or prod.
STAGE=${STAGE}

# Deployment
CLOUDFLARE_ACCOUNT_ID=op://compound-${ENV_TIER}/Cloudflare/account-id
CLOUDFLARE_API_TOKEN=op://compound-${ENV_TIER}/Cloudflare/api-token

# R2
R2_ACCESS_KEY_ID=op://compound-${ENV_TIER}/R2/access-key-id
R2_SECRET_ACCESS_KEY=op://compound-${ENV_TIER}/R2/secret-access-key

# Alchemy
ALCHEMY_PASSWORD=op://compound-${ENV_TIER}/Alchemy/password
ALCHEMY_STATE_TOKEN=op://compound-${ENV_TIER}/Alchemy/state-token

# Convex
CONVEX_DEPLOY_KEY=op://compound-${ENV_TIER}/Convex/deploy-key
CONVEX_MANAGEMENT_TOKEN=op://compound-${ENV_TIER}/Convex/team-access-token

# Auth
BETTER_AUTH_SECRET=op://compound-${ENV_TIER}/Better Auth/secret
RESEND_API_KEY=op://compound-${ENV_TIER}/Resend/api-key

# AI
DEEPGRAM_API_KEY=op://compound-${ENV_TIER}/Deepgram/api-key
GOOGLE_GENERATIVE_AI_API_KEY=op://compound-${ENV_TIER}/Gemini/api-key

# Forced alignment
MODAL_TOKEN_ID=op://compound-${ENV_TIER}/Modal/token-id
MODAL_TOKEN_SECRET=op://compound-${ENV_TIER}/Modal/token-secret
